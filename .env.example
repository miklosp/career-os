# LLM provider — any OpenAI-compatible /v1/chat/completions endpoint
# (e.g. a local proxy, a gateway, or a hosted provider). Copy to .env.
# Required — the dashboard's generation and review steps fail without it.
LLM_PROVIDER_URL=http://localhost:4444
# Required — no hardcoded fallback (stale model IDs rot fast).
GENERATION_MODEL=

# Independent review pass (lib/cv-fact-check.mjs) — two parallel calls. All optional:
#   LLM_REVIEW_PROVIDER_URL → falls back to LLM_PROVIDER_URL if unset
#   REVIEW_MODEL            → falls back to GENERATION_MODEL if unset
#   FACTCHECK_MODEL         → falls back to REVIEW_MODEL if unset
LLM_REVIEW_PROVIDER_URL=
# ATS-simulation half of the review. Same family as Ashby's evaluator. Cheaper swap: openrouter/openai/gpt-5.6-luna
REVIEW_MODEL=openrouter/openai/gpt-5.6-terra
# Citation fact-check half — keep a third family (different from the generator AND REVIEW_MODEL).
FACTCHECK_MODEL=openrouter/google/gemini-3.6-flash

# Coding agent the dashboard launches for the interactive apply flow (`a` key).
# Read by the Go TUI (dashboard/main.go), not by any LLM mode.
# One of: claude | codex | gemini | opencode | pi
# Per-invocation override: $CAREER_OPS_APPLY_CMD (used verbatim as the launcher).
CAREER_OPS_APPLY_AGENT=claude

# Firecrawl — SPA fallback in modes/_fetch.md. Optional. Get a key at
# https://firecrawl.dev
FIRECRAWL_API_KEY=

# Optional LinkedIn cookies for the free authenticated Voyager ATS resolver
# (lib/li-voyager.mjs), used by the LinkedIn scan level. Leave BLANK to run
# the scan without them — discovery + JD still work fully; the employer ATS
# URL is then resolved at apply-time instead of scan-time.
#
# Trade-off: this hits LinkedIn's private reverse-engineered Voyager API,
# which violates LinkedIn's ToS. Use a throwaway account whose risk you
# accept, not your primary profile. To grab the values: log in to LinkedIn
# in a browser → DevTools → Application → Cookies → linkedin.com:
#   LINKEDIN_LI_AT       = the `li_at` cookie value
#   LINKEDIN_JSESSIONID  = the `JSESSIONID` value, INCLUDING the "ajax:" prefix
# 401/403 from Voyager ⇒ cookies expired: re-grab BOTH.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
